include("${CMAKE_CURRENT_LIST_DIR}/Sources.cmake")
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(MAKE_DIRECTORY "${root}/vendor/sources")
foreach(name fltk curl openssl png jpeg zlib webp json)
  set(dest "${root}/vendor/sources/${CPV_${name}_FILE}")
  if(EXISTS "${dest}")
    file(SHA256 "${dest}" actual)
    if(actual STREQUAL CPV_${name}_SHA256)
      message(STATUS "Verified ${CPV_${name}_FILE}")
      continue()
    endif()
    message(FATAL_ERROR "Existing ${dest} has an unexpected hash. Remove it explicitly before refetching.")
  endif()
  file(DOWNLOAD "${CPV_${name}_URL}" "${dest}.part" EXPECTED_HASH "SHA256=${CPV_${name}_SHA256}" TLS_VERIFY ON STATUS status SHOW_PROGRESS)
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE "${dest}.part")
    message(FATAL_ERROR "Cannot fetch ${CPV_${name}_FILE}: ${status}")
  endif()
  file(RENAME "${dest}.part" "${dest}")
endforeach()
