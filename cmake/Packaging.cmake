include(GNUInstallDirs)
set(CMAKE_INSTALL_DOCDIR "share/doc/copyparty-viewer")
install(TARGETS copyparty-viewer RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
install(FILES README.md LICENSE THIRD_PARTY_NOTICES.md BUILDING.md CHANGELOG.md CONTRIBUTING.md SECURITY.md DESTINATION ${CMAKE_INSTALL_DOCDIR})
install(DIRECTORY packaging/third-party-licenses/ DESTINATION ${CMAKE_INSTALL_DOCDIR}/third-party-licenses)
install(DIRECTORY docs/ DESTINATION ${CMAKE_INSTALL_DOCDIR}/docs)
file(READ "${CMAKE_SOURCE_DIR}/LICENSE" project_license)
file(WRITE "${CMAKE_BINARY_DIR}/generated/copyright" "Copyparty Viewer 1.0.0\nCopyright (C) 2026 davoda1\nLicense: MIT\n\nThird-party components retain their own licenses; see THIRD_PARTY_NOTICES.md\nand the accompanying third-party-licenses directory.\n\n${project_license}")
install(FILES "${CMAKE_BINARY_DIR}/generated/copyright" DESTINATION ${CMAKE_INSTALL_DOCDIR})
if(NOT WIN32)
  install(FILES packaging/copyparty-viewer.desktop DESTINATION share/applications)
  install(FILES assets/copyparty.png DESTINATION share/pixmaps RENAME copyparty-viewer.png)
endif()
set(CPV_PACKAGE_BINARY "$<TARGET_FILE:copyparty-viewer>")
set(CPV_PACKAGE_WINDOWS "${WIN32}")
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/ReleaseConfig.cmake" CONTENT "set(CPV_PACKAGE_BINARY \"$<TARGET_FILE:copyparty-viewer>\")\nset(CPV_PACKAGE_WINDOWS \"${WIN32}\")\nset(CPV_SOURCE_DIR \"${CMAKE_SOURCE_DIR}\")\nset(CPV_STRIP \"${CMAKE_STRIP}\")\nset(CPV_READELF \"${CMAKE_READELF}\")\n")
set(CPACK_PACKAGE_NAME "copyparty-viewer")
set(CPACK_PACKAGE_VERSION "1.0.0")
set(CPACK_PACKAGE_VENDOR "davoda1")
set(CPACK_PACKAGE_CONTACT "davoda1")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Read-only Copyparty desktop file viewer")
set(CPACK_PACKAGE_FILE_NAME "copyparty-viewer_1.0.0_amd64")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "davoda1")
set(CPACK_DEBIAN_PACKAGE_ARCHITECTURE "amd64")
set(CPACK_DEBIAN_PACKAGE_SECTION "net")
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libc6 (>= 2.31), libx11-6, libxext6, libxft2, libxrender1, libxfixes3, libxcursor1, libxinerama1, libfontconfig1, ca-certificates")
configure_file("${CMAKE_SOURCE_DIR}/cmake/DebDependencies.cmake" "${CMAKE_BINARY_DIR}/DebDependencies.cmake" COPYONLY)
set(CPACK_PROJECT_CONFIG_FILE "${CMAKE_BINARY_DIR}/DebDependencies.cmake")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_GENERATOR "DEB")
set(CPACK_STRIP_FILES TRUE)
set(CPACK_PACKAGE_DIRECTORY "${CMAKE_SOURCE_DIR}/dist")
include(CPack)
