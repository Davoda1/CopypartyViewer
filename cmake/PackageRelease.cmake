if(NOT CPV_BUILD_DIR)
  message(FATAL_ERROR "CPV_BUILD_DIR is required")
endif()
include("${CPV_BUILD_DIR}/app/ReleaseConfig.cmake")
set(stage "${CPV_BUILD_DIR}/package-stage")
set(dist "${CPV_SOURCE_DIR}/dist")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}" "${dist}")
file(COPY "${CPV_PACKAGE_BINARY}" DESTINATION "${stage}")
get_filename_component(binary_name "${CPV_PACKAGE_BINARY}" NAME)
if(CPV_STRIP AND EXISTS "${CPV_STRIP}")
  execute_process(COMMAND "${CPV_STRIP}" --strip-unneeded --preserve-dates "${stage}/${binary_name}" COMMAND_ERROR_IS_FATAL ANY)
endif()
foreach(doc README.md LICENSE THIRD_PARTY_NOTICES.md BUILDING.md CHANGELOG.md CONTRIBUTING.md SECURITY.md)
  if(EXISTS "${CPV_SOURCE_DIR}/${doc}")
    file(COPY "${CPV_SOURCE_DIR}/${doc}" DESTINATION "${stage}"
      FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  endif()
endforeach()
file(COPY "${CPV_SOURCE_DIR}/packaging/third-party-licenses" DESTINATION "${stage}"
  FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
if(EXISTS "${CPV_SOURCE_DIR}/docs")
  file(COPY "${CPV_SOURCE_DIR}/docs" DESTINATION "${stage}"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
endif()
if(CPV_PACKAGE_WINDOWS)
  set(output "${dist}/Copyparty-Viewer-2.1.0-Windows-x64.zip")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${output}" --format=zip . WORKING_DIRECTORY "${stage}" COMMAND_ERROR_IS_FATAL ANY)
else()
  file(MAKE_DIRECTORY "${stage}/share/applications" "${stage}/share/pixmaps")
  file(COPY "${CPV_SOURCE_DIR}/packaging/copyparty-viewer.desktop" DESTINATION "${stage}/share/applications")
  file(COPY "${CPV_SOURCE_DIR}/assets/copyparty.png" DESTINATION "${stage}/share/pixmaps"
    FILE_PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  file(RENAME "${stage}/share/pixmaps/copyparty.png" "${stage}/share/pixmaps/copyparty-viewer.png")
  set(output "${dist}/Copyparty-Viewer-2.1.0-Linux-amd64.tar.gz")
  include("${CMAKE_CURRENT_LIST_DIR}/ArchiveTar.cmake")
  cpv_create_tar("${output}" "${stage}" .)
  get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
  execute_process(COMMAND "${cmake_bin}/cpack" --config "${CPV_BUILD_DIR}/app/CPackConfig.cmake" -G DEB COMMAND_ERROR_IS_FATAL ANY)
endif()
message(STATUS "Created ${output}")
