if(NOT CPV_BUILD_DIR)
  message(FATAL_ERROR "CPV_BUILD_DIR is required")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(CTEST NAMES ctest HINTS "${cmake_bin}" REQUIRED)
execute_process(COMMAND "${CTEST}" --test-dir "${CPV_BUILD_DIR}/app" --output-on-failure RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Regression tests failed: ${result}")
endif()
