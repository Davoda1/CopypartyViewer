# Optional Linux-to-Windows cross build. Native Windows builds do not use this.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CPV_MINGW_ROOT "" CACHE PATH "Optional relocated MinGW prefix, containing bin")
find_program(CMAKE_C_COMPILER NAMES x86_64-w64-mingw32-gcc-posix x86_64-w64-mingw32-gcc HINTS "${CPV_MINGW_ROOT}/bin" REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES x86_64-w64-mingw32-g++-posix x86_64-w64-mingw32-g++ HINTS "${CPV_MINGW_ROOT}/bin" REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES x86_64-w64-mingw32-windres HINTS "${CPV_MINGW_ROOT}/bin" REQUIRED)
find_program(CMAKE_AR NAMES x86_64-w64-mingw32-ar HINTS "${CPV_MINGW_ROOT}/bin" REQUIRED)
find_program(CMAKE_RANLIB NAMES x86_64-w64-mingw32-ranlib HINTS "${CPV_MINGW_ROOT}/bin" REQUIRED)
set(CMAKE_RC_FLAGS_INIT "--preprocessor=\"${CMAKE_C_COMPILER}\" --preprocessor-arg=-E --preprocessor-arg=-xc --preprocessor-arg=-DRC_INVOKED")
if(CPV_MINGW_ROOT)
  set(CMAKE_FIND_ROOT_PATH "${CPV_MINGW_ROOT}/x86_64-w64-mingw32")
  set(CMAKE_C_FLAGS_INIT "-B${CPV_MINGW_ROOT}/bin/")
  set(CMAKE_CXX_FLAGS_INIT "-B${CPV_MINGW_ROOT}/bin/")
endif()
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE BOTH)
