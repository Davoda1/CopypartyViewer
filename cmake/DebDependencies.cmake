# CPack runs this after the executable has been built, for the selected generator.
# Rebuilds on newer distributions must not retain an inaccurate old libc floor.
if(NOT CPACK_GENERATOR STREQUAL "DEB")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ReleaseConfig.cmake")
if(NOT CPV_READELF OR NOT EXISTS "${CPV_READELF}")
  find_program(CPV_READELF NAMES readelf REQUIRED)
endif()
execute_process(COMMAND "${CPV_READELF}" --version-info "${CPV_PACKAGE_BINARY}" OUTPUT_VARIABLE versions RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Cannot audit executable GLIBC requirements for Debian packaging")
endif()
set(glibc_min "2.31")
string(REGEX MATCHALL "GLIBC_[0-9]+\\.[0-9]+" glibc_symbols "${versions}")
foreach(symbol IN LISTS glibc_symbols)
  string(REPLACE "GLIBC_" "" required "${symbol}")
  if(required VERSION_GREATER glibc_min)
    set(glibc_min "${required}")
  endif()
endforeach()
set(CPACK_DEBIAN_PACKAGE_DEPENDS "libc6 (>= ${glibc_min}), libx11-6, libxext6, libxft2, libxrender1, libxfixes3, libxcursor1, libxinerama1, libfontconfig1, ca-certificates")
message(STATUS "Debian package libc requirement: >= ${glibc_min}")
